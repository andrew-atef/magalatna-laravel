APP_NAME="مجلاتنا"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://magalatna.com

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_TIMEZONE=Africa/Cairo

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_QUEUE_CONNECTION=default

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Cloudflare R2 (High-Performance S3-Compatible Storage)
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=
CLOUDFLARE_R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
CLOUDFLARE_R2_PUBLIC_URL=https://cdn.magalatna.com
CLOUDFLARE_R2_REGION=auto

# Gemini AI
GEMINI_API_KEY=
GEMINI_API_KEYS="" # Comma-separated list of API keys (AIzaSyKey1,AIzaSyKey2,...). If set, used as primary key pool. Falls back to GEMINI_API_KEY if empty.
GEMINI_MODEL=gemini-2.5-flash
# Ordered multi-model waterfall (strict priority order): name:rpm:rpd, comma-separated.
# rpm/rpd optional → default 5 RPM / 20 RPD. Empty → single GEMINI_MODEL @ 15 RPM / 500 RPD.
# RPD counters reset at midnight America/Los_Angeles (Google free-tier reset).
GEMINI_MODELS="gemini-4-hydrogen:5:20,gemini-3.8-flash:5:20,gemini-3.6-flash:5:20,gemini-3.5-flash-lite:15:500"
# Failover strategy: "model_first" (default) = iterate models first, then keys; "key_first" = iterate keys first, then models.
GEMINI_FAILOVER_STRATEGY="model_first"

# Internal Ingestion API
INTERNAL_API_KEY=change-me-to-a-secure-random-string

# Filament Admin Panel — comma-separated email allowlist (config: auth.panel.admin_emails).
# MUST be configured in production: an empty allowlist FAILS CLOSED (no panel
# access for anyone). Local/dev falls back to any verified user email.
# Example: FILAMENT_ADMIN_EMAILS=andrew@magalatna.com,admin@magalatna.com
FILAMENT_ADMIN_EMAILS=

# Radar Ingest Webhook Secret — shared with the Cloudflare Worker & GitHub Actions radar.
# Send as: X-Ingest-Secret: <value>  (or ?secret=<value> as fallback).
# Generate: php artisan tinker --execute="echo Str::random(64);"
INGEST_WEBHOOK_SECRET=change-me-to-a-64-char-random-string

# IndexNow
INDEXNOW_KEY=
INDEXNOW_BASE_URI=https://api.indexnow.org/indexnow

# Cloudflare Edge Cache Purge
CLOUDFLARE_CACHE_API_TOKEN=
CLOUDFLARE_ZONE_ID=

# Google Analytics 4 (GA4)
GOOGLE_ANALYTICS_ID=

# Google Indexing API (optional)
GOOGLE_INDEXING_ENABLED=false
GOOGLE_INDEXING_CREDENTIALS_FILE=app/google-service-account.json

# Flyers — Auto publish AI-ingested flyers directly (true) or keep pending_review for manual review (false)
AUTO_PUBLISH_FLYERS=true

VITE_APP_NAME="${APP_NAME}"

# Facebook Vercel Proxy Mesh (serverless egress for FB scraping)
FACEBOOK_PROXY_URL=
FACEBOOK_PROXY_SECRET=

# Cloudflare full-browser harvester (event-driven Tier 2)
CLOUDFLARE_HARVESTER_URL=

# Firecrawl managed cloud browser (last-resort fallback for login-walled pages)
FIRECRAWL_API_KEY=

# Reels (720x1280 vertical shorts)
# libass font family for burned-in captions — MUST be an installed Arabic
# family on the server (fonts-noto-core / Cairo). Verify with: fc-list :lang=ar
REELS_CAPTION_FONT_NAME="Noto Sans Arabic"
REELS_CAPTION_FONT_SIZE=54
REELS_ENDCARD_FONT_SIZE=62

# Telegram Bot Publishing
# Create a bot via @BotFather, add it as admin to your channel/group
# Get chat_id: @channelusername or numeric -100xxxxxxxxxx
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_AUTO_PUBLISH=true
TELEGRAM_TIMEOUT=30
